generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  AVAILABLE
  LOW_STOCK
  EXPIRING
  QUARANTINE
  INACTIVE
}

enum TransactionType {
  INCOMING
  OUTGOING
  ADJUSTMENT
  TRANSFER
  MUTATION
}

enum ApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum DistributionStatus {
  PICKING
  PACKING
  LOADING
  SHIPPING
  DELIVERED
  COMPLETED
}

enum PaymentMethod {
  CASH
  TRANSFER
  QRIS
}

model User {
  id          String     @id @default(cuid())
  name        String
  email       String     @unique
  roleId      String
  role        Role       @relation(fields: [roleId], references: [id])
  auditLogs   AuditLog[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  permissions Permission[]
  users       User[]
}

model Permission {
  id        String @id @default(cuid())
  action    String
  subject   String
  roleId    String
  role      Role   @relation(fields: [roleId], references: [id])

  @@unique([action, subject, roleId])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Supplier {
  id           String          @id @default(cuid())
  company      String
  contact      String
  phone        String
  email        String?
  address      String
  taxNumber    String?
  paymentTerms String
  products     Product[]
  purchaseOrders PurchaseOrder[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Warehouse {
  id        String    @id @default(cuid())
  name      String    @unique
  type      String
  racks     Rack[]
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Rack {
  id          String    @id @default(cuid())
  code        String
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  products    Product[]

  @@unique([code, warehouseId])
}

model Product {
  id              String                 @id @default(cuid())
  sku             String                 @unique
  barcode         String                 @unique
  qrCode          String?
  name            String
  brand           String
  unit            String
  purchasePrice   Decimal                @db.Decimal(14, 2)
  retailPrice     Decimal                @db.Decimal(14, 2)
  minimumStock    Int
  maximumStock    Int
  currentStock    Int                    @default(0)
  locationRack    String
  batchNumber     String?
  expirationDate  DateTime?
  status          ProductStatus          @default(AVAILABLE)
  notes           String?
  categoryId      String
  category        Category               @relation(fields: [categoryId], references: [id])
  supplierId      String
  supplier        Supplier               @relation(fields: [supplierId], references: [id])
  warehouseId     String
  warehouse       Warehouse              @relation(fields: [warehouseId], references: [id])
  rackId          String?
  rack            Rack?                  @relation(fields: [rackId], references: [id])
  batches         ProductBatch[]
  transactions    InventoryTransaction[]
  purchaseItems   PurchaseOrderItem[]
  saleItems       RetailSaleItem[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
}

model ProductBatch {
  id             String    @id @default(cuid())
  productId      String
  product        Product   @relation(fields: [productId], references: [id])
  batchNumber    String
  expirationDate DateTime?
  quantity       Int
  createdAt      DateTime  @default(now())

  @@unique([productId, batchNumber])
}

model PurchaseRequest {
  id          String         @id @default(cuid())
  number      String         @unique
  status      ApprovalStatus @default(DRAFT)
  reason      String
  orders      PurchaseOrder[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model PurchaseOrder {
  id                String              @id @default(cuid())
  number            String              @unique
  supplierId        String
  supplier          Supplier            @relation(fields: [supplierId], references: [id])
  requestId         String?
  request           PurchaseRequest?    @relation(fields: [requestId], references: [id])
  status            ApprovalStatus      @default(PENDING)
  items             PurchaseOrderItem[]
  receivingGoods    ReceivingGoods[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Int
  price           Decimal       @db.Decimal(14, 2)
}

model ReceivingGoods {
  id              String        @id @default(cuid())
  number          String        @unique
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  receivedAt      DateTime      @default(now())
  status          ApprovalStatus @default(PENDING)
}

model InventoryTransaction {
  id          String          @id @default(cuid())
  number      String          @unique
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  type        TransactionType
  quantity    Int
  batchNumber String?
  reason      String?
  createdAt   DateTime        @default(now())
}

model DistributionOrder {
  id        String             @id @default(cuid())
  number    String             @unique
  status    DistributionStatus @default(PICKING)
  driver    String?
  address   String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model GoodsRequest {
  id        String         @id @default(cuid())
  number    String         @unique
  requester String
  status    ApprovalStatus @default(PENDING)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model StockOpname {
  id          String         @id @default(cuid())
  number      String         @unique
  systemStock Int
  actualStock Int
  difference  Int
  reason      String?
  status      ApprovalStatus @default(PENDING)
  createdAt   DateTime       @default(now())
}

model RetailSale {
  id            String           @id @default(cuid())
  number        String           @unique
  paymentMethod PaymentMethod
  total         Decimal          @db.Decimal(14, 2)
  items         RetailSaleItem[]
  createdAt     DateTime         @default(now())
}

model RetailSaleItem {
  id           String     @id @default(cuid())
  retailSaleId String
  retailSale   RetailSale @relation(fields: [retailSaleId], references: [id])
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  quantity     Int
  price        Decimal    @db.Decimal(14, 2)
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  createdAt DateTime @default(now())
}
