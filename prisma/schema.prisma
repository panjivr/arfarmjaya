generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Single shared workspace document. The whole app dataset (products,
// transactions, invoices, settings, audit log, etc.) is stored as one JSON
// blob so every device/browser reads and writes the same data.
model Workspace {
  id        String   @id @default("main")
  data      Json
  updatedAt DateTime @updatedAt
}

// Akun pengguna untuk RBAC (auth server-side). Password disimpan sebagai hash
// (scrypt), bukan plaintext. Akun lama tidak dihapus — nonaktifkan via `active`.
model AppUser {
  id           String    @id @default(cuid())
  name         String
  username     String    @unique
  passwordHash String
  role         String    @default("STAFF_LELE")
  active       Boolean   @default(true)
  permissions  String[]  @default([])
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
}
